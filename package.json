{
  "name": "freedom-browser",
  "desktopName": "freedom-browser",
  "private": true,
  "version": "0.6.4-4",
  "description": "Lightweight, fast, and privacy-focused cross-platform desktop web browser",
  "author": "Freedom Browser Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "electron . --dev",
    "electron:start": "electron .",
    "build:appimage": "npm run build && electron-builder --linux AppImage --publish never",
    "build:win": "npm run build && electron-builder --win nsis zip --publish never",
    "build:win:installer": "npm run build && electron-builder --win nsis --publish never",
    "build:dist": "npm run build && electron-builder --linux AppImage && electron-builder --win portable zip",
    "tauri": "tauri",
    "build:linux": "bash scripts/build-linux.sh"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "org.freedom.browser",
    "productName": "Freedom Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icons/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "HTML Document",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "HTML Document",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": "shtml",
        "name": "HTML Document",
        "description": "HTML Document",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": "xhtml",
        "name": "XHTML Document",
        "description": "XHTML Document",
        "mimeType": "application/xhtml+xml",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icons",
      "syncDesktopName": true,
      "mimeTypes": [
        "text/html",
        "text/xml",
        "application/xhtml+xml",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "artifactName": "Freedom-Browser-${version}-x86_64.${ext}",
      "executableName": "freedom-browser",
      "desktop": {
        "entry": {
          "Name": "Freedom Browser",
          "StartupWMClass": "freedom-browser"
        }
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icons/icon.ico",
      "fileAssociations": [
        {
          "ext": "html",
          "name": "HTML Document",
          "description": "HTML Document",
          "role": "Viewer"
        },
        {
          "ext": "htm",
          "name": "HTML Document",
          "description": "HTML Document",
          "role": "Viewer"
        }
      ],
      "artifactName": "Freedom-Browser-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Freedom Browser",
      "uninstallDisplayName": "Freedom Browser",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Freedom-Browser-${version}-x64-Setup.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "runAfterFinish": true,
      "menuCategory": false
    },
    "executableName": "freedom-browser",
    "copyright": "Freedom Browser Team"
  }
}
